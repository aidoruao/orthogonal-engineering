# ORTHOGONAL_GB_ORIGIN.rules - Zed IDE Configuration
# Version: 1.12
# Generated: 2026-01-21
# Schema ID: GB-ORIGIN-1.12

# ============================================================================
# CORE DIRECTIVE
# ============================================================================
# Enforce the Glass-Box Boundary as defined in GLASS_BOX_BOUNDARY_v1.11.html
# and generate the enforcement system accordingly.

# ============================================================================
# SINGLE SOURCE OF TRUTH
# ============================================================================
Use `GLASS_BOX_BOUNDARY_v1.11.html` as the single source of truth for:
• Schema + enforcement
• Python enforcer generation
• IDE enforcement patterns
• Boundary and orthogonal separation rules
• Trace structure + signing + fail-fast rules

# ============================================================================
# ZED IDE INTEGRATION RULES
# ============================================================================

# 1. AUTO-GENERATE PYTHON ENFORCER
# ----------------------------------------------------------------------------
on_project_open:
  - check: file_exists("documentation/GLASS_BOX_BOUNDARY_v1.11.html")
  - action: generate_python_enforcer
    template: glass_box_boundary
    output: automation/run_full_audit_with_trace.py
    requirements:
      - scan_repository_for_artifacts
      - snapshot_environment
      - detect_suppressed_signals
      - detect_pii_violations
      - record_timeline_sequence
      - compute_hash_manifest
      - sign_trace_with_private_key
      - exit_code_2_on_violation

# 2. BOUNDARY ENFORCEMENT DECORATOR
# ----------------------------------------------------------------------------
on_python_file_create:
  - pattern: "*.py"
  - action: inject_boundary_decorator
    decorator: "@glass_box_boundary"
    requirements:
      - input_validation
      - output_validation
      - side_effect_confinement
      - orthogonal_separation
    violation_action: raise_exception_immediately

# 3. AUTOFIX SUGGESTIONS
# ----------------------------------------------------------------------------
on_code_violation:
  - pattern: "direct_io_without_gateway"
    suggestion: "Add gateway interface for I/O operations"
    fix: inject_gateway_pattern

  - pattern: "broad_exception_catch"
    suggestion: "Replace 'except Exception:' with specific exception handling"
    fix: replace_with_specific_exceptions

  - pattern: "missing_input_validation"
    suggestion: "Add input validation schema"
    fix: add_validation_schema

  - pattern: "missing_output_validation"
    suggestion: "Add output validation schema"
    fix: add_output_schema

  - pattern: "regex_generation"
    suggestion: "Regex generation banned - use deterministic string methods instead"
    fix: replace_regex_with_deterministic_methods
    severity: critical
    violation_class: REGEX_GENERATION_BAN

  - pattern: "pii_content_detected"
    suggestion: "PII content detected - remove or sanitize personal information"
    fix: sanitize_pii_content
    severity: critical
    violation_class: PII_BOUNDARY_VIOLATION

# 4. STRUCTURAL CONSISTENCY
# ----------------------------------------------------------------------------
on_new_file:
  - pattern: "*.py"
    action: auto_include:
      - relevant_imports
      - boundary_decorators
      - exception_handlers
      - logging_infrastructure
    based_on: GLASS_BOX_BOUNDARY_v1.11.html

# 5. BOUNDARY AWARENESS
# ----------------------------------------------------------------------------
on_code_analysis:
  - pattern: "ui->database_direct_path"
    detection: "Direct database access from UI layer"
    suggestion: "Insert intermediary gateway pattern"
    fix: inject_gateway_interface

  - pattern: "uncaptured_side_effect"
    detection: "Function modifies external state without interface"
    suggestion: "Capture side effects through defined gateway"
    fix: add_side_effect_gateway

  - pattern: "combinatorial_explosion"
    detection: "Unbounded regex or combinatorial construct causing token explosion"
    suggestion: "Replace with bounded, deterministic algorithm"
    fix: replace_with_bounded_algorithm
    severity: critical
    violation_class: COMBINATORIAL_EXPLOSION_BAN

  - pattern: "pii_boundary_violation"
    detection: "Personal information or sensitive content detected"
    suggestion: "Apply PII sanitization or remove personal content"
    fix: apply_pii_sanitization
    severity: critical
    violation_class: PII_BOUNDARY_VIOLATION

# 6. DOCUMENTATION SYNC
# ----------------------------------------------------------------------------
on_python_enforcer_update:
  - trigger: "file_modified('automation/run_full_audit_with_trace.py')"
  - action: propose_html_update
    source: python_changes
    target: documentation/GLASS_BOX_BOUNDARY_v1.11.html
    create: draft_change_request
    commit: true

# ============================================================================
# META-TRACE ENFORCEMENT
# ============================================================================
meta_trace_validation:
  required_fields:
    - python_enforcer_active: true
    - ide_integration:
        autofix_enabled: true
        structural_consistency: true
        boundary_awareness: true
        pii_enforcement: true
        doc_sync: true

  validation_trigger: "absence_of_any_field"
  action: "exit_code_2"

# ============================================================================
# TRACE VALIDATION LOOP
# ============================================================================
on_ci_event:
  - action: run_python_enforcer
    command: "python automation/run_full_audit_with_trace.py"

  - action: validate_trace
    schema: documentation/GLASS_BOX_BOUNDARY_v1.11.html

  - action: report_violations
    format: inline

  - rule: fail_fast
    condition: boundary_violation_detected
    action: exit_code_2
    message: "Boundary violation detected - failing loudly"

  - rule: regex_ban
    condition: regex_generation_detected
    action: exit_code_2
    message: "Regex generation banned - combinatorial explosion risk"
    additional_action: log_combinatorial_violation

  - rule: pii_ban
    condition: pii_content_detected
    action: exit_code_2
    message: "PII content detected - social harm risk"
    additional_action: log_pii_violation

# ============================================================================
# CONTINUOUS SYNC & SELF-HEALING
# ============================================================================
continuous_sync:
  - trigger: python_enforcer_logic_update
    actions:
      - propose_corresponding_html_updates
      - create_draft_change_request_for_schema
      - commit_the_update

  - rule: traceability
    requirement: "All code must be traceable back to atomic instructions in HTML"
    violation_action: reject_code_generation

  - rule: bounded_computation
    requirement: "All algorithms must have bounded time/space complexity"
    violation_patterns:
      - ".*\\*.*"  # Unbounded regex quantifiers
      - "\\.\\+\\?"  # Greedy/lazy quantifiers
      - "\\(.*\\)\\{.*,.*\\}"  # Unbounded repetition
      - "lookahead|lookbehind"  # Complex regex features
    violation_action: reject_with_explanation
    explanation: "Unbounded combinatorial constructs violate subtractive clarity canon"

  - rule: pii_boundary
    requirement: "No personal, sensitive, or relational content in commits"
    violation_patterns:
      - "middle\\s+school\\s+girl|minor\\s+reference"
      - "christian\\s+apologetics|religious\\s+training"
      - "karambit|weapons\\s+training"
      - "why\\s+me\\s+sociological\\s+analysis"
      - "personal\\s+therapy\\s+notes|selective\\s+mutism"
      - "personal\\s+development\\s+plan\\s+for\\s+others"
    violation_action: reject_with_explanation
    explanation: "Personal information violates PII Canon - social harm risk"

# ============================================================================
# EXIT CODE SPECIFICATION
# ============================================================================
exit_codes:
  0: "Success (all checks passed, trace valid)"
  1: "System error (unexpected failure)"
  2: "Boundary violation (schema violation, missing artifact, suppressed signal, PII violation)"
  3: "Environment mismatch (python version, dependencies)"
  4: "Timeline sequence violation"
  5: "Signature verification failed"
  6: "PII Canon violation (personal/sensitive content detected)"

# ============================================================================
# REQUIRED ARTIFACTS (NON-NEGOTIABLE)
# ============================================================================
required_artifacts:
  - automation/full_audit.py
  - automation/generate_sha256_manifest.py
  - automation/verify_sha256_manifest.py
  - documentation/README.md
  - grounding_models/GROUNDING_MODELS.md
  - historical_candidates/HISTORICAL_LOGOS_CANDIDATES.md
  - correspondence_bridge/correspondence_validator_final.py

# ============================================================================
# SUPPRESSED SIGNALS DETECTION
# ============================================================================
suppressed_signals_detection:
  patterns:
    - "except Exception: pass"
    - "warnings.filterwarnings('ignore')"
    - "logging.getLogger().setLevel(logging.CRITICAL)"
    - "sys.exit(0) # when actual failure occurred"
    - "re\\.(search|match|findall|finditer|sub|split)\\(.*\\*.*\\)"  # Unbounded regex
    - "re\\.(search|match|findall|finditer|sub|split)\\(.*\\+.*\\)"  # Unbounded regex
    - "re\\.(search|match|findall|finditer|sub|split)\\(.*\\?.*\\)"  # Optional with unbounded
    - "re\\.(search|match|findall|finditer|sub|split)\\(.*\\{.*,.*\\}\\)"  # Unbounded repetition
    - "middle\\s+school\\s+girl.*except.*pass"  # PII with suppressed error
    - "personal\\s+content.*warnings\\.filterwarnings"  # PII with warning suppression

  action: "report_as_violation"
  severity: "critical"

# ============================================================================
# TIMELINE SEQUENCE RULES
# ============================================================================
timeline_sequence:
  required_events:
    - environment_snapshot
    - artifact_scan
    - boundary_validation
    - signal_detection
    - pii_detection
    - hash_computation
    - trace_signing

  violation_patterns:
    - "validation_after_execution"
    - "signing_before_hashing"
    - "artifact_scan_after_boundary_check"
    - "pii_detection_after_commit"

  action: "exit_code_4"

# ============================================================================
# REGEX BOUNDARY ENFORCEMENT
# ============================================================================
regex_boundary:
  banned_patterns:
    # Unbounded quantifiers
    - ".*"
    - ".+"
    - ".?"
    - ".{n,}"  # Minimum with no maximum
    - ".{,m}"  # No minimum with maximum

    # Complex features that cause combinatorial explosion
    - "lookahead"
    - "lookbehind"
    - "backreference"
    - "recursive"
    - "possessive"

    # Nested quantifiers
    - "\\(.*\\).*\\*"
    - "\\[.*\\].*\\+"

    # Alternation with unbounded patterns
    - ".*\\|.*"
    - ".+\\|.+"

  allowed_patterns:
    # Only bounded, deterministic patterns allowed
    - "^[a-zA-Z0-9_]+$"  # Simple identifier
    - "^\\d{4}-\\d{2}-\\d{2}$"  # Date pattern
    - "^[A-Z]{3}$"  # Three-letter code
    - "\\s+"  # Whitespace (bounded by line)

    # Simple character classes with bounds
    - "[a-z]{1,10}"
    - "\\d{1,5}"
    - "[A-Z][a-z]*"

  enforcement:
    - static_analysis: reject_banned_patterns
    - runtime_monitoring: detect_combinatorial_explosion
    - autofix: replace_with_string_methods
    - severity: critical
    - exit_code: 2

  continuity_requirements:
    - maintain_session_state_across_crashes
    - preserve_boundary_violation_logs
    - restore_ide_state_after_regex_crash
    - preserve_pii_violation_logs_locally_only

# ============================================================================
# ENFORCEMENT PRIORITY
# ============================================================================
priority: highest
scope: project_wide
applicable_languages:
  - python
  - markdown
  - html
  - json
  - regex_patterns  # Special category for regex boundary enforcement
  - chat_exports    # Special category for PII boundary enforcement
  - conversation_files  # Special category for PII boundary enforcement

# ============================================================================
# COMPLIANCE VERIFICATION
# ============================================================================
compliance_check:
  frequency: "on_save"
  tools:
    - python_enforcer
    - trace_validator
    - boundary_scanner

  reporting:
    format: "inline_annotations"
    action: "block_on_violation"

  special_rules:
    - regex_boundary_enforcement: immediate_block
    - combinatorial_explosion_detection: preemptive_halt
    - pii_boundary_enforcement: atomic_block
    - continuity_preservation: session_state_backup

# ============================================================================
# FINAL RULE
# ============================================================================
final_rule: |
  Zed must never produce code that cannot be traced back to
  the atomic instructions in GLASS_BOX_BOUNDARY_v1.11.html.

  All generated code must have a clear lineage to the HTML schema,
  and all enforcement must be verifiable against the trace contract.

  SPECIAL RULE: REGEX GENERATION BAN
  Due to orthogonal-engineering-scale combinatorial explosion risks:
  1. No AI-generated regex patterns with unbounded quantifiers
  2. No complex regex features (lookahead, lookbehind, backreferences)
  3. All string processing must use bounded, deterministic methods
  4. Violation triggers immediate exit code 2 and session state preservation

  This ban enforces the Subtractive Clarity Canon: remove ambiguity
  (combinatorial explosion) rather than add capability (powerful regex).

  SPECIAL RULE: PII CANON ENFORCEMENT
  Due to social harm risks and privacy requirements:
  1. No personal, sensitive, or relational content in commits
  2. No minor references, therapy notes, or personal development plans
  3. No mixed professional/personal content - strict separation required
  4. All personal chats stay local, never committed to repository
  5. Violation triggers immediate exit code 6 and atomic rollback

  This enforces the PII Canon: protect human safety and privacy while
  maintaining professional clarity and subtractive boundaries.

# End of ORTHOGONAL_GB_ORIGIN.rules
