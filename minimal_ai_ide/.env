# MAXIMAL ORACLE v57 - ENVIRONMENT CONFIGURATION
# Generated by setup_v57.py

# DeepSeek API Configuration
DEEPSEEK_API_KEY=YOUR_API_KEY_HERE
DEEPSEEK_ENDPOINT=https://api.deepseek.com/v1/chat/completions

# Security Configuration
TOKEN_SECRET=generate-a-random-secret-here

# System Configuration
WORKSPACE_DIR=./workspace_v57
RATE_LIMIT_PER_SEC=4
MAX_RETRIES=5
SNAPSHOT_INTERVAL=10

# Prometheus Metrics
PROMETHEUS_PORT=8057
METRICS_ENABLED=true

# V57 Specific Configuration
V57_MODE=falsificationist
V57_WORKSPACE=./workspace_v57
V57_CONFIG=v57_config.json

# Logging
LOG_LEVEL=INFO
LOG_FILE=./maximal_oracle_v57.log
