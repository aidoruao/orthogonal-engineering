            raise PermissionError(f"pid={pid} lacks READ cap for {path}")

        content = self._files.get(current.content_hash, b"")

        # Verify integrity
        actual_hash = self._hash(content)
        if actual_hash != current.content_hash:
            raise RuntimeError(
                f"Integrity violation: expected {current.content_hash}, got {actual_hash}"
            )

        proof = ProofObject(
            conclusion=f"File read: {path} hash={current.content_hash[:16]}... verified",
            premises=[f"Cap verified", f"Integrity: SHA-256 match"],
            rule="vfs_read",
