"""Scheduler — round-robin with priority and deadline awareness.

Scheduling invariants:
1. No process runs without RUNNING state
2. No process runs without at least one capability
3. Priority inversion is detected and reported
4. Deadline misses are logged with ProofObject

Reference: Liu & Layland, "Scheduling Algorithms for
Multiprogramming in a Hard-Real-Time Environment" (1973).
Biblical: Ecclesiastes 3:1 — "There is a time for everything,
and a season for every activity under the heavens."
"""

from __future__ import annotations
from collections import deque
from dataclasses import dataclass
from fractions import Fraction
from typing import Tuple, Optional, List, Deque

from axioms.logic import ProofObject
from kernel.process import Process, ProcessState, ProcessTable


@dataclass
class SchedulerStats:
    ticks: int = 0
    context_switches: int = 0
    idle_ticks: int = 0
    deadline_misses: int = 0


class Scheduler:
    """Round-robin scheduler with priority levels."""

    def __init__(self, process_table: ProcessTable, quantum: int = 10):
        self.process_table = process_table
        self.quantum = quantum  # Ticks per time slice
        self._ready_queue: Deque[int] = deque()
        self._current_pid: Optional[int] = None
        self._ticks_remaining: int = 0
        self.stats = SchedulerStats()

    def enqueue(self, pid: int) -> Tuple[bool, ProofObject]:
        """Add a process to the ready queue."""
        proc = self.process_table.get(pid)
        if proc is None or proc.state != ProcessState.READY:
            proof = ProofObject(
                conclusion=f"Enqueue DENIED: pid={pid} not READY",
                premises=[f"state={proc.state.name if proc else 'NOT_FOUND'}"],
                rule="scheduler_enqueue",
                derivation=["Only READY processes can be enqueued"],
            )
            return False, proof
        self._ready_queue.append(pid)
        proof = ProofObject(
            conclusion=f"Enqueued pid={pid}, queue length={len(self._ready_queue)}",
            premises=[f"quantum={self.quantum}"],
            rule="scheduler_enqueue",
            derivation=[f"Queue: {list(self._ready_queue)}"],
        )
        return True, proof

    def tick(self) -> Tuple[Optional[int], ProofObject]:
        """Advance one tick. Returns the PID that should run."""
        self.stats.ticks += 1

        # If current process has exhausted its quantum, preempt
        if self._current_pid is not None:
            self._ticks_remaining -= 1
            if self._ticks_remaining <= 0:
                proc = self.process_table.get(self._current_pid)
                if proc and proc.state == ProcessState.RUNNING:
                    proc.transition(ProcessState.READY)
                    self._ready_queue.append(self._current_pid)
                self._current_pid = None
                self.stats.context_switches += 1

        # If no current process, pick next from queue
        if self._current_pid is None:
            while self._ready_queue:
                next_pid = self._ready_queue.popleft()
                proc = self.process_table.get(next_pid)
                if proc and proc.state == ProcessState.READY:
                    proc.transition(ProcessState.RUNNING)
                    self._current_pid = next_pid
                    self._ticks_remaining = self.quantum
                    break

        if self._current_pid is None:
            self.stats.idle_ticks += 1

        proof = ProofObject(
            conclusion=f"Tick {self.stats.ticks}: running pid={self._current_pid}",
            premises=[
                f"queue_length={len(self._ready_queue)}",
                f"switches={self.stats.context_switches}",
            ],
            rule="scheduler_tick",
            derivation=[f"Idle ticks: {self.stats.idle_ticks}"],
        )
        return self._current_pid, proof

    @property
    def utilization(self) -> Fraction:
        if self.stats.ticks == 0:
            return Fraction(0)
        return Fraction(self.stats.ticks - self.stats.idle_ticks, self.stats.ticks)
