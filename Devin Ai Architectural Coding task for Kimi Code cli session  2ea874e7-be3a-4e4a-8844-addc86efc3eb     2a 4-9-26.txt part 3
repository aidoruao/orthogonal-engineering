        proof = ProofObject(
            conclusion=f"Wrote {len(data)} bytes to region {self.region_id} at offset {offset}",
            premises=[f"bounds_ok=True"],
            rule="memory_write",
            derivation=[f"Region {self.region_id}: {self.base}+{self.size}"],
