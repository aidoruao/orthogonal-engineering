            conclusion=f"Revoked {revoked_count} capabilities (transitive)",
            premises=[f"root_nonce={nonce[:16]}..."],
            rule="capability_revocation",
            derivation=[f"Transitive closure over parent_nonce chain"],
        )
        return revoked_count, proof
