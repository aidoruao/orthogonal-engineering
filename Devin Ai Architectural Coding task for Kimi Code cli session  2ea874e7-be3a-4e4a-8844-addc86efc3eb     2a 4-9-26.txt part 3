        self._total = total_memory
        self._allocated = 0

    def allocate(self, owner_pid: int, size: int,
                 region_type: RegionType = RegionType.HEAP,
                 permissions: Permission = Permission.READ | Permission.WRITE
                 ) -> Tuple[MemoryRegion, ProofObject]:
        """Allocate a new memory region."""
