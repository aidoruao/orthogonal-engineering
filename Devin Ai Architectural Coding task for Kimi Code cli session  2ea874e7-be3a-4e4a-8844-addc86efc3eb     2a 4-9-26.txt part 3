from __future__ import annotations
import hashlib
import secrets
from dataclasses import dataclass, field
from enum import Flag, auto
from fractions import Fraction
from typing import Tuple, Optional, Set, Dict, FrozenSet

from axioms.logic import ProofObject


class Permission(Flag):
    """Permissions that a capability can grant."""
    NONE = 0
    READ = auto()
    WRITE = auto()
    EXECUTE = auto()
    CREATE = auto()
    DELETE = auto()
    SEND = auto()      # IPC send
    RECEIVE = auto()   # IPC receive
    GRANT = auto()     # Can delegate capability to another process
    REVOKE = auto()    # Can revoke delegated capabilities

    ALL = READ | WRITE | EXECUTE | CREATE | DELETE | SEND | RECEIVE | GRANT | REVOKE


@dataclass(frozen=True)
class Capability:
    """An unforgeable capability token."""
    resource_id: str
    permissions: Permission
    nonce: str = field(default_factory=lambda: secrets.token_hex(16))
    parent_nonce: Optional[str] = None  # For revocation chains
    owner_pid: int = 0

    @property
    def fingerprint(self) -> str:
        """SHA-256 fingerprint of this capability."""
        data = f"{self.resource_id}:{self.permissions.value}:{self.nonce}"
        return hashlib.sha256(data.encode()).hexdigest()

    def attenuate(self, new_permissions: Permission, new_owner: int) -> Tuple[Capability, ProofObject]:
        """Create a new capability with reduced permissions.

        Attenuation can only REMOVE permissions, never ADD.
        The new capability's parent_nonce points to this one
        for revocation chain tracking.
        """
        if new_permissions & ~self.permissions:
            raise PermissionError(
                f"Cannot attenuate: {new_permissions} contains permissions "
                f"not in {self.permissions}"
            )
        new_cap = Capability(
            resource_id=self.resource_id,
            permissions=new_permissions,
            parent_nonce=self.nonce,
            owner_pid=new_owner,
        )
        proof = ProofObject(
            conclusion=f"Capability attenuated: {self.permissions} -> {new_permissions}",
            premises=[
                f"Original: {self.fingerprint[:16]}...",
                f"New: {new_cap.fingerprint[:16]}...",
                f"Permissions subset: {(new_permissions & ~self.permissions) == Permission.NONE}",
            ],
            rule="capability_attenuation",
            derivation=["New permissions are a subset of original permissions"],
        )
        return new_cap, proof


class CapabilityTable:
    """Per-process capability table."""

    def __init__(self, pid: int):
        self.pid = pid
        self._caps: Dict[str, Capability] = {}
        self._revoked: Set[str] = set()

    def insert(self, cap: Capability) -> Tuple[bool, ProofObject]:
        """Insert a capability into this table."""
        if cap.nonce in self._revoked:
            proof = ProofObject(
                conclusion="Capability insertion REJECTED: revoked",
                premises=[f"nonce={cap.nonce[:16]}..."],
                rule="capability_revocation_check",
                derivation=["Nonce found in revocation set"],
            )
            return False, proof
        self._caps[cap.nonce] = cap
        proof = ProofObject(
            conclusion=f"Capability inserted for resource {cap.resource_id}",
            premises=[f"pid={self.pid}", f"permissions={cap.permissions}"],
            rule="capability_insert",
            derivation=[f"Table now has {len(self._caps)} capabilities"],
        )
        return True, proof

    def check(self, resource_id: str, required: Permission) -> Tuple[bool, ProofObject]:
        """Check if this table has a capability for the given resource with required permissions."""
        for cap in self._caps.values():
            if cap.resource_id == resource_id and (cap.permissions & required) == required:
                if cap.nonce not in self._revoked:
                    proof = ProofObject(
                        conclusion=f"Access GRANTED: {resource_id} with {required}",
                        premises=[f"cap={cap.fingerprint[:16]}...", f"pid={self.pid}"],
                        rule="capability_check",
                        derivation=["Matching capability found with sufficient permissions"],
                    )
                    return True, proof
        proof = ProofObject(
            conclusion=f"Access DENIED: {resource_id} with {required}",
            premises=[f"pid={self.pid}", f"caps_checked={len(self._caps)}"],
            rule="capability_check",
            derivation=["No matching capability with sufficient permissions"],
        )
        return False, proof

    def revoke(self, nonce: str) -> Tuple[int, ProofObject]:
        """Revoke a capability and all its children (transitively)."""
        revoked_count = 0
        to_revoke = {nonce}
        while to_revoke:
            current = to_revoke.pop()
            if current not in self._revoked:
                self._revoked.add(current)
                revoked_count += 1
