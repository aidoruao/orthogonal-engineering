        if region.owner_pid != requesting_pid:
            proof = ProofObject(
                conclusion=f"Free DENIED: pid={requesting_pid} does not own {region_id}",
                premises=[f"owner={region.owner_pid}"],
                rule="memory_free",
                derivation=["Requesting PID != owner PID"],
            )
            return False, proof
        self._allocated -= region.size
        del self._regions[region_id]
        proof = ProofObject(
            conclusion=f"Freed region {region_id} ({region.size} bytes)",
            premises=[f"pid={requesting_pid}"],
            rule="memory_free",
            derivation=[f"Total allocated: {self._allocated}/{self._total}"],
        )
        return True, proof

    @property
    def utilization(self) -> Fraction:
        return Fraction(self._allocated, self._total)
