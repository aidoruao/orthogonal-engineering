from dataclasses import dataclass, field
from enum import Enum, auto
from fractions import Fraction
from typing import Tuple, List, Dict, Optional, Callable

from axioms.logic import ProofObject
from kernel.capability import Capability, CapabilityTable, Permission


class ProcessState(Enum):
    EMBRYO = auto()      # Created but not yet scheduled
    READY = auto()       # Ready to run
    RUNNING = auto()     # Currently executing
    BLOCKED = auto()     # Waiting for IPC/IO
    TERMINATED = auto()  # Finished (normal or error)


@dataclass
class Process:
    """A kernel process with capability-gated access."""
    pid: int
    name: str
    state: ProcessState = ProcessState.EMBRYO
    cap_table: CapabilityTable = field(default=None)
    parent_pid: Optional[int] = None
    children: List[int] = field(default_factory=list)
    exit_code: Optional[int] = None
    audit_trail: List[ProofObject] = field(default_factory=list)

    def __post_init__(self):
        if self.cap_table is None:
            self.cap_table = CapabilityTable(self.pid)

    def transition(self, new_state: ProcessState) -> Tuple[bool, ProofObject]:
        """Transition to a new state. Returns (success, proof)."""
        valid_transitions = {
            ProcessState.EMBRYO: {ProcessState.READY},
            ProcessState.READY: {ProcessState.RUNNING, ProcessState.TERMINATED},
            ProcessState.RUNNING: {ProcessState.READY, ProcessState.BLOCKED, ProcessState.TERMINATED},
            ProcessState.BLOCKED: {ProcessState.READY, ProcessState.TERMINATED},
            ProcessState.TERMINATED: set(),  # Terminal state
        }
        allowed = valid_transitions.get(self.state, set())
        if new_state in allowed:
            old_state = self.state
            self.state = new_state
            proof = ProofObject(
                conclusion=f"Process {self.pid} transitioned: {old_state.name} -> {new_state.name}",
                premises=[f"pid={self.pid}", f"valid_transitions={[s.name for s in allowed]}"],
                rule="process_state_transition",
                derivation=[f"New state {new_state.name} is in valid set"],
            )
            self.audit_trail.append(proof)
            return True, proof
        proof = ProofObject(
            conclusion=f"Process {self.pid} transition DENIED: {self.state.name} -> {new_state.name}",
            premises=[f"allowed={[s.name for s in allowed]}"],
            rule="process_state_transition",
            derivation=[f"{new_state.name} not in valid transitions from {self.state.name}"],
        )
        self.audit_trail.append(proof)
        return False, proof


class ProcessTable:
    """Kernel process table."""

    def __init__(self):
        self._processes: Dict[int, Process] = {}
        self._next_pid: int = 1  # PID 0 is kernel

    def spawn(self, name: str, parent_pid: Optional[int] = None,
              initial_caps: Optional[List[Capability]] = None) -> Tuple[Process, ProofObject]:
        """Spawn a new process."""
        pid = self._next_pid
        self._next_pid += 1
        proc = Process(pid=pid, name=name, parent_pid=parent_pid)

        # Grant initial capabilities
        if initial_caps:
            for cap in initial_caps:
                attenuated = Capability(
                    resource_id=cap.resource_id,
                    permissions=cap.permissions,
                    parent_nonce=cap.nonce,
                    owner_pid=pid,
                )
                proc.cap_table.insert(attenuated)

        # Register parent-child relationship
        if parent_pid is not None and parent_pid in self._processes:
            self._processes[parent_pid].children.append(pid)

        self._processes[pid] = proc

        # Transition to READY
        proc.transition(ProcessState.READY)

        proof = ProofObject(
            conclusion=f"Process spawned: pid={pid}, name={name}",
            premises=[
                f"parent={parent_pid}",
                f"initial_caps={len(initial_caps) if initial_caps else 0}",
            ],
            rule="process_spawn",
            derivation=[f"Total processes: {len(self._processes)}"],
        )
        return proc, proof

    def terminate(self, pid: int, exit_code: int = 0) -> Tuple[bool, ProofObject]:
        """Terminate a process."""
        if pid not in self._processes:
            proof = ProofObject(
                conclusion=f"Terminate FAILED: pid={pid} not found",
                premises=[], rule="process_terminate",
                derivation=["PID not in process table"],
            )
            return False, proof
        proc = self._processes[pid]
        success, trans_proof = proc.transition(ProcessState.TERMINATED)
        proc.exit_code = exit_code
        proof = ProofObject(
            conclusion=f"Process {pid} terminated with exit code {exit_code}",
            premises=[trans_proof.conclusion],
            rule="process_terminate",
            derivation=[f"Remaining processes: {sum(1 for p in self._processes.values() if p.state != ProcessState.TERMINATED)}"],
        )
        return success, proof

    def get(self, pid: int) -> Optional[Process]:
        return self._processes.get(pid)

    @property
    def count_active(self) -> int:
        return sum(1 for p in self._processes.values()
                   if p.state != ProcessState.TERMINATED)
