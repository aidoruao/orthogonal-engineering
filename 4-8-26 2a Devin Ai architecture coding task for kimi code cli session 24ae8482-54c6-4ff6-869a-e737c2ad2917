def get_type(name: str) -> Tuple[TypeNode, ProofObject]:  
    """Look up a type by name. Returns (TypeNode, ProofObject)."""  
    if name not in TYPE_REGISTRY:  
        raise KeyError(f"Type '{name}' not in registry. "  
                       f"Known types: {sorted(TYPE_REGISTRY.keys())}")  
    node = TYPE_REGISTRY[name]  
    proof = ProofObject(  
        conclusion=f"Type '{name}' exists in universe {node.universe.name}",  
        premises=[f"kind={node.kind.name}", f"multiplicity={node.multiplicity.name}"],  
        rule="type_lookup",  
        derivation=[f"Registry contains {len(TYPE_REGISTRY)} types"]  
    )  
    return node, proof  
  
