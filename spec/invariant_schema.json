{
  "schema_version": "1.0.0",
  "pr": 38,
  "layer": "Autonomous Mathematical Sovereignty Layer (AMSL)",
  "standard": "Yeshua",
  "description": "Machine-readable invariant specification for the AMSL. Spec > code. Once frozen, a version is immutable.",
  "frozen": true,
  "freeze_version": "v1",
