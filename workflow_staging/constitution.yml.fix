# FIX for .github/workflows/constitution.yml
# 
# Problem: The "V - Global Merkle root tests" step runs pytest which calls 
# build_global_merkle() but never writes merkle/global_root.json.
# The upload step then fails because the file doesn't exist.
#
# Solution: Add a step BEFORE "V - Global Merkle root tests" that generates
# the global Merkle root file.
#
# Apply this fix by adding the following step between 
# "IX - Benchmark suite" and "V - Global Merkle root tests":

      - name: Generate global Merkle root
        run: python merkle/global_merkle.py

# The resulting order should be:
#   1. IX - Benchmark suite
#   2. Generate global Merkle root  (NEW STEP)
#   3. V - Global Merkle root tests
#   4. Upload global Merkle root artifact
#
# This ensures merkle/global_root.json exists before tests try to read it
# and before the upload step tries to upload it.
