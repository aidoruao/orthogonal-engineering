{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "certificate",
  "type": "object",
  "required": ["certificate_id", "candidate_id", "issued_at", "attempt_id", "transcript_hash", "score_hash", "capabilities", "signature", "witness_entry_id"],
  "properties": {
    "certificate_id": {"type": "string"},
    "candidate_id": {"type": "string"},
    "issued_at": {"type": "string", "format": "date-time"},
    "attempt_id": {"type": "string"},
    "transcript_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "score_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "signature": {"type": "string"},
    "witness_entry_id": {"type": "string"},
    "sponsor_id": {"type": "string"}
  },
  "additionalProperties": false
}
