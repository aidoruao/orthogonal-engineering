{
  "schema_version": "1.0.0",
  "pr": 38,
  "standard": "Yeshua",
  "description": "Schema for proof bundle archives used in fork-resilience and reconstruction.",
  "archive": {
    "required_fields": [
      "archive_version",
      "created_at",
      "invariant_spec_version",
      "proof_bundles"
    ],
    "proof_bundle": {
      "required_fields": [
        "merkle_root",
        "output_hash",
        "environment_hash",
        "timestamp",
        "invariant_spec_version",
        "node_id",
        "record_hash"
      ],
      "hash_algorithm": "sha256",
      "merkle_algorithm": "sha256_binary_tree"
    }
  },
  "example": {
    "archive_version": "1.0.0",
    "created_at": "2026-02-22T23:45:04Z",
    "invariant_spec_version": "v1",
    "proof_bundles": [
      {
        "merkle_root": "<sha256>",
        "output_hash": "<sha256>",
        "environment_hash": "<sha256>",
        "timestamp": "2026-02-22T23:45:04Z",
        "invariant_spec_version": "v1",
        "node_id": "node-ubuntu-01",
        "record_hash": "<sha256>"
      }
    ]
  },
  "policy": {
    "archives_immutable_once_published": true,
    "reconstruction_possible_from_archive_alone": true
  }
}
