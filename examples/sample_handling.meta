<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sample GTA V handling.meta snippet
  
  This is a simplified example showing the structure of CHandlingData entries.
  Real handling.meta files contain many more attributes.
-->
<CHandlingDataMgr>
  <HandlingData>
    <Item type="CHandlingData">
      <handlingName>ADDER</handlingName>
      <fMass value="1500.000000" />
      <fInitialDragCoeff value="10.000000" />
      <fDownforceModifier value="1.000000" />
      
      <!-- Damage multipliers (Phase 1 clamps) -->
      <fCollisionDamageMult value="1.500000" />
      <fEngineDamageMult value="1.800000" />
      <fDeformationDamageMult value="0.700000" />
      
      <!-- Suspension (Phase 2 clamps) -->
      <fSuspensionForce value="2.500000" />
      <fSuspensionCompDamp value="1.200000" />
      <fSuspensionReboundDamp value="2.000000" />
      <fSuspensionUpperLimit value="0.100000" />
      <fSuspensionLowerLimit value="-0.120000" />
      <fSuspensionRaise value="0.000000" />
      <fSuspensionBiasFront value="0.500000" />
      <fSuspensionBiasRear value="0.500000" />
      
      <!-- Traction (Phase 2 clamps) -->
      <fTractionCurveMax value="2.350000" />
      <fTractionCurveMin value="2.100000" />
      <fTractionCurveLateral value="22.500000" />
      <fTractionSpringDeltaMax value="0.150000" />
      <fTractionBiasFront value="0.485000" />
      <fTractionBiasRear value="0.515000" />
      
      <!-- Braking (Phase 2 clamps) -->
      <fBrakeForce value="1.200000" />
      <fBrakeBiasFront value="0.550000" />
      <fBrakeBiasRear value="0.450000" />
      
      <!-- Center of Mass (Phase 2 clamps) -->
      <vecCentreOfMassOffset x="0.000000" y="0.100000" z="0.000000" />
      <!-- Note: These would map to vecCentreOfMassOffsetX, Y, Z in our parser -->
    </Item>
    
    <Item type="CHandlingData">
      <handlingName>ZENTORNO</handlingName>
      <fMass value="1400.000000" />
      
      <!-- Example with out-of-range values that would be clamped -->
      <fCollisionDamageMult value="3.500000" />  <!-- Would be clamped to 1.8 -->
      <fEngineDamageMult value="0.200000" />     <!-- Would be clamped to 1.0 -->
      <fDeformationDamageMult value="0.100000" /><!-- Would be clamped to 0.5 -->
      
      <fSuspensionForce value="2.200000" />
      <fTractionCurveMax value="2.400000" />
      <fBrakeForce value="1.000000" />
      
      <vecCentreOfMassOffset x="0.000000" y="0.050000" z="0.000000" />
    </Item>
  </HandlingData>
</CHandlingDataMgr>
