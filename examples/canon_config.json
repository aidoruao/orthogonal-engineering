{
  "description": "Example configuration for GTA handling.meta clamp pipeline",
  "version": "1.0.0",
  "clamp_rules": [
    {
      "field_name": "fMass",
      "min_value": 0.0,
      "max_value": 50000.0,
      "description": "Vehicle mass in kilograms"
    },
    {
      "field_name": "fInitialDragCoeff",
      "min_value": 0.0,
      "max_value": 100.0,
      "description": "Initial drag coefficient"
    },
    {
      "field_name": "fDriveInertia",
      "min_value": 0.0,
      "max_value": 10.0,
      "description": "Drive inertia multiplier"
    },
    {
      "field_name": "fClutchChangeRateScaleUpShift",
      "min_value": 0.0,
      "max_value": 10.0,
      "description": "Clutch change rate for upshifts"
    },
    {
      "field_name": "fClutchChangeRateScaleDownShift",
      "min_value": 0.0,
      "max_value": 10.0,
      "description": "Clutch change rate for downshifts"
    },
    {
      "field_name": "fBrakeForce",
      "min_value": 0.0,
      "max_value": 10.0,
      "description": "Brake force multiplier"
    }
  ]
}
