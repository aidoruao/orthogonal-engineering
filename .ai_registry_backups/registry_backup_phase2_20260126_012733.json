{
  "base_ai": {
    "model": "llama3.1:70b",
    "api_endpoint": "http://localhost:11434",
    "status": "active",
    "version": "1.0.0",
    "last_health_check": null
  },
  "wardens": {},
  "dynamic_wardens": {
    "unclassified_folders": [],
    "temporary_wardens": {}
  },
  "health_checks": {
    "interval_seconds": 300,
    "failure_threshold": 3,
    "auto_restart": true
  },
