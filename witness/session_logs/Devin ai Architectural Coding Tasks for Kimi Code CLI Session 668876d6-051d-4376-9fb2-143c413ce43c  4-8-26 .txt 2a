python3 -c "  
import json, glob, hashlib  
studies = []  
for f in sorted(glob.glob('case_studies/category_*/CS_*.json')):  
    with open(f) as fh:  
        data = json.load(fh)  
    h = hashlib.sha256(json.dumps(data, sort_keys=True).encode()).hexdigest()[:16]  
    studies.append({  
        'category': f.split('/')[1].replace('category_',''),  
        'content_hash': h,  
        'file': f,  
        'id': data['id'],  
        'title': data['title'],  
    })  
with open('case_studies/CASE_STUDY_INDEX.json', 'w') as f:  
    json.dump({'case_studies': studies}, f, indent=2)  
print(f'Index updated: {len(studies)} case studies')  
"  
  
