"""Cryptographic verification — Hash chains, Merkle proofs, commitment schemes.

Implements verifiable computation primitives with ProofObject derivations.
All operations return (result, ProofObject) pairs.

Mathematical foundation: Menezes, Oorschot & Vanstone,
    "Handbook of Applied Cryptography"
Biblical: Proverbs 25:2 — "It is the glory of God to conceal a matter;
    to search out a matter is the glory of kings."
"""

import hashlib
from dataclasses import dataclass, field
from fractions import Fraction
from typing import List, Tuple, Optional

@dataclass
class ProofObject:
    conclusion: str
    premises: List[str]
    rule: str
    derivation: List[str] = field(default_factory=list)

# ─── Hash Chain ───

@dataclass
class HashChainLink:
    index: int
    data: str
    previous_hash: str
    current_hash: str

def compute_hash(data: str, previous_hash: str) -> str:
    return hashlib.sha256(f"{previous_hash}:{data}".encode()).hexdigest()

def build_hash_chain(entries: List[str]) -> Tuple[List[HashChainLink], ProofObject]:
    chain = []
    prev = "0" * 64
    for i, entry in enumerate(entries):
        h = compute_hash(entry, prev)
        chain.append(HashChainLink(index=i, data=entry, previous_hash=prev, current_hash=h))
        prev = h
    proof = ProofObject(
        conclusion=f"Hash chain of {len(entries)} links built",
        premises=[f"SHA-256 chaining from genesis hash"],
        rule="hash_chain_construction",
        derivation=[f"Link {i}: {link.current_hash[:16]}..." for i, link in enumerate(chain)]
    )
    return chain, proof

def verify_hash_chain(chain: List[HashChainLink]) -> Tuple[bool, ProofObject]:
    for i, link in enumerate(chain):
        expected = compute_hash(link.data, link.previous_hash)
        if expected != link.current_hash:
            return False, ProofObject(
                conclusion=f"Chain broken at link {i}",
                premises=[f"Expected {expected[:16]}, got {link.current_hash[:16]}"],
                rule="hash_chain_verification",
            )
        if i > 0 and link.previous_hash != chain[i-1].current_hash:
            return False, ProofObject(
                conclusion=f"Chain discontinuity at link {i}",
                premises=[f"Previous hash mismatch"],
                rule="hash_chain_verification",
            )
    return True, ProofObject(
        conclusion=f"Hash chain of {len(chain)} links verified",
        premises=[f"All links consistent"],
        rule="hash_chain_verification",
    )

# ─── Merkle Tree ───

def merkle_hash(left: str, right: str) -> str:
    return hashlib.sha256(f"{left}{right}".encode()).hexdigest()

def build_merkle_tree(leaves: List[str]) -> Tuple[str, List[List[str]], ProofObject]:
    if not leaves:
        return "0" * 64, [[]], ProofObject(
            conclusion="Empty Merkle tree",
            premises=[], rule="merkle_empty")
    current_level = [hashlib.sha256(leaf.encode()).hexdigest() for leaf in leaves]
    levels = [current_level[:]]
    while len(current_level) > 1:
        next_level = []
        for i in range(0, len(current_level), 2):
            left = current_level[i]
            right = current_level[i+1] if i+1 < len(current_level) else left
            next_level.append(merkle_hash(left, right))
        current_level = next_level
        levels.append(current_level[:])
    root = current_level[0]
    proof = ProofObject(
        conclusion=f"Merkle root: {root[:16]}...",
        premises=[f"{len(leaves)} leaves, {len(levels)} levels"],
        rule="merkle_construction",
    )
    return root, levels, proof

def merkle_proof(leaf_index: int, levels: List[List[str]]) -> Tuple[List[Tuple[str, str]], ProofObject]:
    path = []
    idx = leaf_index
    for level in levels[:-1]:
        if idx % 2 == 0:
            sibling = level[idx+1] if idx+1 < len(level) else level[idx]
            path.append((sibling, "right"))
        else:
            path.append((level[idx-1], "left"))
        idx //= 2
    proof = ProofObject(
        conclusion=f"Merkle proof for leaf {leaf_index}: {len(path)} steps",
        premises=[f"Path from leaf to root"],
        rule="merkle_proof_generation",
    )
    return path, proof

def verify_merkle_proof(leaf: str, proof_path: List[Tuple[str, str]], root: str) -> Tuple[bool, ProofObject]:
    current = hashlib.sha256(leaf.encode()).hexdigest()
    for sibling, direction in proof_path:
        if direction == "left":
            current = merkle_hash(sibling, current)
        else:
            current = merkle_hash(current, sibling)
    valid = current == root
    return valid, ProofObject(
        conclusion=f"Merkle proof {'valid' if valid else 'INVALID'}",
        premises=[f"Leaf hash: {current[:16]}..., Root: {root[:16]}..."],
        rule="merkle_proof_verification",
    )

# ─── Commitment Scheme (Pedersen-style, simplified) ───

def commit(value: int, blinding: int, modulus: int, g: int, h: int) -> Tuple[int, ProofObject]:
    commitment = (pow(g, value, modulus) * pow(h, blinding, modulus)) % modulus
    proof = ProofObject(
        conclusion=f"Commitment: {commitment}",
        premises=[f"g^v * h^r mod p"],
        rule="pedersen_commit",
    )
    return commitment, proof

def verify_commitment(commitment: int, value: int, blinding: int,
                      modulus: int, g: int, h: int) -> Tuple[bool, ProofObject]:
    expected = (pow(g, value, modulus) * pow(h, blinding, modulus)) % modulus
    valid = expected == commitment
    return valid, ProofObject(
        conclusion=f"Commitment {'valid' if valid else 'INVALID'}",
        premises=[f"Recomputed: {expected}, Given: {commitment}"],
        rule="pedersen_verify",
    )
